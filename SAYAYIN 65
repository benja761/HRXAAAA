--// SWITCH
local function addSwitch(y,text,callback)
	local frame = Instance.new("Frame", content)
	frame.Position = UDim2.new(0.05,0,y,0)
	frame.Size = UDim2.new(0.9,0,0,26)
	frame.BackgroundTransparency = 1

	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(0.7,0,1,0)
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255,255,255)
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left

	local switch = Instance.new("Frame", frame)
	switch.Size = UDim2.new(0,36,0,18)
	switch.Position = UDim2.new(0.75,0,0.15,0)
	switch.BackgroundColor3 = Color3.fromRGB(60,60,60)
	Instance.new("UICorner", switch).CornerRadius = UDim.new(1,0)

	local knob = Instance.new("Frame", switch)
	knob.Size = UDim2.new(0,16,1,0)
	knob.BackgroundColor3 = THEME_COLOR
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

	local state = false
	local function toggle()
		state = not state
		knob:TweenPosition(UDim2.new(state and 1 or 0,0,0,0),
			Enum.EasingDirection.Out,Enum.EasingStyle.Quad,0.2,true)
		callback(state)
	end

	switch.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then toggle() end
	end)
	label.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then toggle() end
	end)
end

