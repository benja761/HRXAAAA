--// AIM TARGET
local function getClosestTarget(partName)
	local closest, dist = nil, math.huge
	local center = Cam.ViewportSize/2
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			if ignoreFriends and lp:IsFriendsWith(p.UserId) then continue end
			local targetPart
			if partName == "Head" and p.Character:FindFirstChild("Head") then
				targetPart = p.Character.Head
			elseif partName == "Chest" or partName == "Feet" then
				targetPart = p.Character:FindFirstChild("HumanoidRootPart")
			end
			if targetPart then
				local pos, vis = Cam:WorldToViewportPoint(targetPart.Position)
				local mag = (Vector2.new(pos.X,pos.Y)-center).Magnitude
				if vis and mag < dist and mag < fovRadius then
					dist = mag
					closest = targetPart
				end
			end
		end
	end
	return closest
end

--// INPUT
UIS.InputBegan:Connect(function(i,gp)
	if gp then return end
	if _G.toggleGuiKey and i.KeyCode == _G.toggleGuiKey then
		guiVisible = not guiVisible
		gui.Enabled = guiVisible
	end
	if _G.toggleFOVKey and i.KeyCode == _G.toggleFOVKey then
		fovVisible = not fovVisible
		FOV.Visible = fovVisible
	end
	if _G.aimKey and i.KeyCode.Name == _G.aimKey then
		aimEnabled = not aimEnabled
		if not aimEnabled then targetLocked = nil end
	end
	if _G.fakeFriendKey and i.KeyCode.Name == _G.fakeFriendKey then
		ignoreFriends = not ignoreFriends
	end
end)

--// HEALTH BARS
local HealthBars = {}
RunService.RenderStepped:Connect(function()
	if not stateHealthBar then
		for _,v in pairs(HealthBars) do
			if v.Frame then v.Frame.Visible = false end
		end
		return
	end

	for _,p in pairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and p.Character:FindFirstChild("Head") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local head = p.Character.Head
			if hum and head then
				if not HealthBars[p] then
					local frame = Instance.new("Frame", healthGui)
					frame.Size = UDim2.new(0,80,0,12)
					frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
					frame.BorderSizePixel = 0
					Instance.new("UICorner", frame).CornerRadius = UDim.new(1,0)

					local bar = Instance.new("Frame", frame)
					bar.Size = UDim2.new(1,0,1,0)
					bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
					bar.BorderSizePixel = 0
					Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

					local text = Instance.new("TextLabel", frame)
					text.Size = UDim2.new(1,0,1,0)
					text.BackgroundTransparency = 1
					text.Font = Enum.Font.GothamBold
					text.TextSize = 14
					text.TextColor3 = Color3.fromRGB(0,255,0)
					text.TextStrokeTransparency = 0.5
					text.TextScaled = true
					text.TextXAlignment = Enum.TextXAlignment.Center
					text.TextYAlignment = Enum.TextYAlignment.Center

					HealthBars[p] = {Frame=frame,Bar=bar,Text=text}
				end

				local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
				local hb = HealthBars[p]
				hb.Bar.Size = UDim2.new(ratio,0,1,0)
				hb.Text.Text = math.floor(hum.Health).." / "..math.floor(hum.MaxHealth)

				local pos, vis = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,2,0))
				if vis and pos.Z > 0 then
					hb.Frame.Position = UDim2.new(0, pos.X - hb.Frame.Size.X.Offset/2, 0, pos.Y)
					hb.Frame.Visible = true
				else
					hb.Frame.Visible = false
				end
			end
		end
	end
end)

--// LOOP AIM + FOV
RunService.RenderStepped:Connect(function()
	-- FOV en el centro de pantalla
	if fovFollowCursor then
		FOV.Position = UIS:GetMouseLocation()
	else
		FOV.Position = Cam.ViewportSize/2
	end
	FOV.Radius = fovRadius
	FOV.Visible = fovVisible

	if aimEnabled then
		if not targetLocked or not targetLocked.Parent then
			targetLocked = getClosestTarget(aimPart)
		end
		if targetLocked then
			local currentCF = Cam.CFrame
			local targetCF = CFrame.lookAt(currentCF.Position, targetLocked.Position)
			local lerpAmount = 1 - (smoothValue/10)
			Cam.CFrame = currentCF:Lerp(targetCF, lerpAmount)
		end
	else
		targetLocked = nil
	end
end)
