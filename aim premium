--// AIM TARGET
local function getClosestTarget(partName)
	local closest, dist = nil, math.huge
	local center = Cam.ViewportSize/2
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			if ignoreFriends and lp:IsFriendsWith(p.UserId) then continue end
			local targetPart
			if partName == "Head" and p.Character:FindFirstChild("Head") then
				targetPart = p.Character.Head
			elseif partName == "Pecho" then
				targetPart = p.Character:FindFirstChild("HumanoidRootPart")
			elseif partName == "Pies" then
				targetPart = p.Character:FindFirstChild("HumanoidRootPart")
			end
			if targetPart then
				local pos, vis = Cam:WorldToViewportPoint(targetPart.Position)
				local mag = (Vector2.new(pos.X,pos.Y)-center).Magnitude
				if vis and mag < dist and mag < fovRadius then
					dist = mag
					closest = targetPart
				end
			end
		end
	end
	return closest
end

--// INPUT
UIS.InputBegan:Connect(function(i,gp)
	if gp then return end
	if _G.toggleGuiKey and i.KeyCode == _G.toggleGuiKey then
		guiVisible = not guiVisible
		gui.Enabled = guiVisible
	end
	if _G.toggleFOVKey and i.KeyCode == _G.toggleFOVKey then
		fovVisible = not fovVisible
		FOV.Visible = fovVisible
	end
	if _G.aimKey and i.KeyCode.Name == _G.aimKey then
		aimEnabled = not aimEnabled
		if not aimEnabled then targetLocked = nil end
	end
end)

--// LOOP
RunService.RenderStepped:Connect(function()
	FOV.Position = Cam.ViewportSize/2
	FOV.Radius = fovRadius
	FOV.Visible = fovVisible

	if aimEnabled then
		if not targetLocked or not targetLocked.Parent then
			targetLocked = getClosestTarget(aimPart)
		end
		if targetLocked then
			local currentCF = Cam.CFrame
			local targetCF = CFrame.lookAt(currentCF.Position, targetLocked.Position)
			local lerpAmount = 1 - (smoothValue/10)
			Cam.CFrame = currentCF:Lerp(targetCF, lerpAmount)
		end
	else
		targetLocked = nil
	end
end)
